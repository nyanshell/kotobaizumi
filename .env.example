# Copy this file to .env and fill in your actual values

# OpenAI API key for translations and grammar explanations
OPENAI_API_KEY=your_openai_api_key_here

# Azure Speech Services token for TTS
AZURE_SERVICE_TOKEN=your_azure_speech_token_here

# Optional: Azure region (default: japaneast)
REGION=japaneast

# Optional: Custom data folder path (default: ./data)
DATA_FOLDER=./data

# Flask secret key for sessions (generate a random string for production)
SECRET_KEY=your_secret_key_here_use_random_string_in_production

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=1

# Copy this file to .env and fill in your actual values

# LLM Provider: Choose 'openai' or 'gemini' (default: gemini)
LLM_PROVIDER=gemini

# Gemini API Configuration (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Gemini model (default: gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-pro

# OpenAI API Configuration (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
# Optional: OpenAI model (default: gpt-5)
OPENAI_MODEL=gpt-5

# Azure Speech Services token for TTS
AZURE_SERVICE_TOKEN=your_azure_speech_token_here

# Optional: Azure region (default: japaneast)
REGION=japaneast

# Optional: Custom data folder path (default: ./data)
DATA_FOLDER=./data

# Flask secret key for sessions (generate a random string for production)
SECRET_KEY=your_secret_key_here_use_random_string_in_production

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=1
